{
  "schema_version": "gaussian_direct128_app_config_v1",
  "architecture": {
    "experiment": "scratch",
    "gaussian_dim": 128,
    "gaussian_architecture": "vg",
    "direct_protein_head": true,
    "direct_protein_residual": false,
    "bypass_gaussian": false,
    "co_update_rounds": 3,
    "dropout": 0.1
  },
  "runtime": {
    "accelerator": "gpu",
    "devices": 2,
    "precision": "16-mixed",
    "seed": 42,
    "num_workers": 2,
    "log_every": 50
  },
  "training": {
    "output_dir": "../runs/pinder_rebuild_training",
    "data": {
      "train_manifest": "../datasets/pinder_rebuild/train.csv",
      "train_compact_dir": "../datasets/pinder_rebuild/compact",
      "expected_train_rows": 0
    },
    "optimizer": {
      "epochs": 20,
      "schedule_epochs": 20,
      "local_batch_size": 4,
      "atom_lr": 0.0001,
      "gaussian_lr": 0.0001,
      "warmup_ratio": 0.05,
      "min_lr_ratio": 0.1,
      "weight_decay": 0.0001,
      "pos_weight_factor": 0.5
    }
  },
  "preprocessing": {
    "manifest": "../datasets/pinder_rebuild/train.csv",
    "output_dir": "../datasets/pinder_rebuild/compact",
    "workers": 16,
    "torch_threads": 1,
    "max_num_nn": 64,
    "payload": "training",
    "progress_every": 1000,
    "chunksize": 8
  }
}
