{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/m4/manifest.schema.json",
  "title": "M4 manifest row",
  "type": "object",
  "required": ["apex_case_id", "input_state", "receptor_pdb_path", "input_residue_ids", "labels", "label_mask", "num_residues"],
  "properties": {
    "apex_case_id": {"type": "string", "minLength": 1},
    "system_id": {"type": "string"},
    "input_state": {"enum": ["apo", "af2", "holo"]},
    "receptor_pdb_path": {"type": "string", "minLength": 1},
    "partner_sequence": {"type": "string"},
    "input_residue_ids": {"type": "string", "description": "Semicolon-delimited residue IDs in strict encoder order."},
    "labels": {"type": "string", "description": "Semicolon-delimited labels; predict uses generated technical zeros only."},
    "label_mask": {"type": "string", "description": "Semicolon-delimited 0/1 validity mask."},
    "num_residues": {"type": ["integer", "string"]},
    "num_positive_labels": {"type": ["integer", "string"]},
    "mask_coverage": {"type": ["number", "string"]},
    "cluster_id": {"type": "string"},
    "tensor_cache_labels_from_manifest": {"type": ["boolean", "string"]}
  },
  "additionalProperties": true
}
